{
  "name": "s3-minio-storage-system",
  "version": "1.3.0",
  "description": "Production-ready S3-compatible Object Storage management platform powered by Next.js 14, MinIO, TypeScript, and AWS SDK v3.",
  "main": "index.js",
  "author": "Ayush Singh <ayushhsinghhe01@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eayushsingh/s3Bucket.git"
  },
  "keywords": [
    "s3",
    "minio",
    "object-storage",
    "nextjs",
    "typescript",
    "aws-sdk",
    "presigned-urls",
    "multipart-upload",
    "cloud-storage",
    "self-hosted"
  ],
  "scripts": {
    "dev": "tsx scripts/start-minio.ts && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
