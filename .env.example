# ==============================================================================
# S3 / MinIO Object Storage Configuration
# ==============================================================================

# Storage Endpoint (MinIO local endpoint or cloud S3 endpoint)
STORAGE_ENDPOINT=http://127.0.0.1:9000

# Region (us-east-1 is standard default for MinIO and AWS S3)
STORAGE_REGION=us-east-1

# Credentials (Keep secret! Never commit real secrets to Git)
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_secure_password_123

# SSL Setting (false for local http://localhost:9000, true for production https://)
STORAGE_USE_SSL=false

# S3 Path Style (Required 'true' for MinIO, Ceph, LocalStack; 'false' for AWS virtual-hosted style)
STORAGE_FORCE_PATH_STYLE=true

# Public endpoint for presigned URLs if frontend connects via a different host/domain (e.g. reverse proxy)
# Defaults to STORAGE_ENDPOINT if empty
NEXT_PUBLIC_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# Default buckets to initialize automatically
STORAGE_DEFAULT_BUCKETS=app-uploads,app-images,app-documents,app-public,app-private,app-backups

# Default Upload Expiration (seconds)
STORAGE_PRESIGNED_UPLOAD_EXPIRY=900

# Default Download Expiration (seconds)
STORAGE_PRESIGNED_DOWNLOAD_EXPIRY=3600

# Max Upload File Size in Bytes (Default: 5GB for multipart, 100MB for single-part)
STORAGE_MAX_FILE_SIZE_BYTES=5368709120

# Application Port
PORT=3000

# Application Database Path (SQLite file path)
DATABASE_PATH=./data/metadata.sqlite
